# Browser-safe Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase and PostgreSQL configuration.
# Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
DATABASE_URL=
DATABASE_MIGRATION_URL=
APP_RUNTIME_DATABASE_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Added after the webhook endpoint is deployed; must differ from the API secret.
RAZORPAY_WEBHOOK_SECRET=

# Application controls.
APP_URL=
APP_ENV=
PAYMENTS_MODE=
ADMIN_EMAIL=admin@example.com
# At least 16 random characters. Vercel sends it as a Bearer token to cron routes.
CRON_SECRET=

